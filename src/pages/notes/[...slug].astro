---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('notes');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date) {
  return new Date(date).toLocaleDateString('en-GB', {
    year: 'numeric', month: 'long', day: 'numeric'
  });
}
---
<Base title={post.data.title} description={post.data.description}>
  <article class="container" style="padding-bottom:6rem;">
    <header class="post-header">
      <div class="post-header__meta">
        <span>{formatDate(post.data.date)}</span>
        {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
        {post.data.tags && post.data.tags.map(tag => <span>{tag}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      {post.data.description && (
        <p style="font-size:1.15rem;color:var(--text-dim);margin-top:0.75rem;line-height:1.6;">{post.data.description}</p>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    <div style="margin-top:4rem;padding-top:2rem;border-top:1px solid var(--border);">
      <a href="/notes" class="btn btn--ghost">← All posts</a>
    </div>
  </article>
</Base>
