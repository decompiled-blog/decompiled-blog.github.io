---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date) {
  return new Date(date).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
}

// Group by year
const byYear = posts.reduce((acc, post) => {
  const year = new Date(post.data.date).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => b - a);
---
<Base title="Notes">
  <div class="container" style="padding-top:4rem;padding-bottom:6rem;">
    <h1 style="margin-bottom:0.5rem;">Notes</h1>
    <p style="color:var(--text-dim);margin-bottom:3rem;">
      Breakdowns of codebases, papers, systems, and ideas.
    </p>

    {posts.length === 0 ? (
      <div style="background:var(--bg2);border:1px solid var(--border);border-radius:4px;padding:2rem;text-align:center;">
        <p style="font-family:var(--mono);font-size:0.85rem;color:var(--text-dim);">// nothing here yet</p>
      </div>
    ) : years.map(year => (
      <div style="margin-bottom:3rem;">
        <p class="section-label">{year}</p>
        <div class="post-grid">
          {byYear[year].map(post => (
            <a href={`/notes/${post.id}`} class="post-card">
              <div>
                <div class="post-card__title">{post.data.title}</div>
                {post.data.description && (
                  <div class="post-card__desc">{post.data.description}</div>
                )}
                {post.data.tags && (
                  <div class="post-card__tags">
                    {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                  </div>
                )}
              </div>
              <div class="post-card__meta">{formatDate(post.data.date)}</div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</Base>
