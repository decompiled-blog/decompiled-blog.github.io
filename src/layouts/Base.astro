---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.astro';
const { title = 'Decompiled', description = 'Taking things apart to see how they work.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title === 'Decompiled' ? 'Decompiled' : `${title} | Decompiled`}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- KaTeX CSS for math rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
</head>
<body>

  <header class="site-header">
    <div class="container--wide">
      <nav class="site-header__inner">
        <a href="/" class="site-logo"><span>decompiled</span></a>
        <div class="site-nav">
          <search-trigger id="searchTrigger" />
          <a href="/timeline">Timeline</a>
          <a href="/stats">Stats</a>
          <a href="/source" class={currentPath.startsWith('/source') ? 'active' : ''}>Source</a>
          <a href="/notes" class={currentPath.startsWith('/notes') ? 'active' : ''}>Notes</a>
          <a href="/projects" class={currentPath.startsWith('/projects') ? 'active hide-mobile' : 'hide-mobile'}>Projects</a>
          <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About</a>
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">◑</button>
        </div>
      </nav>
    </div>
  </header> 

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container--wide">
      <div class="site-footer__inner">
        <p>// decompiled — no black boxes.</p>
        <p>built with astro · hosted on github pages</p>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('themeToggle');
    const html = document.documentElement;

    const saved = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', saved);

    toggle?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);  
    });
  </script>

<SearchModal />

</body>
</html>
